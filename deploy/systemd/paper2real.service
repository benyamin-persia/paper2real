[Unit]
Description=Paper2Real FastAPI trader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=paper2real
Group=paper2real
WorkingDirectory=/opt/paper2real
EnvironmentFile=/opt/paper2real/.env
ExecStart=/opt/paper2real/venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
