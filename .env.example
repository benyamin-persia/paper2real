# Copy to .env and fill in — never commit .env (see .gitignore). Rotate keys if they were ever pasted into chat or a ticket.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
WEBHOOK_SECRET=my_secret_123
STARTING_BALANCE=10000
TRADE_SIZE_PCT=0.10
MAX_OPEN_TRADES=3
MAX_DRAWDOWN_PCT=20
MAX_CONSECUTIVE_LOSS=4
DAILY_LOSS_LIMIT_PCT=5
MONTHLY_LOSS_LIMIT_PCT=15
# SQLite path: default paper_trader.db in cwd; TrueNAS Docker bind mount uses /app/paper_trader.db
DB_FILE=paper_trader.db
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_SEVERITY=WARNING
SHADOW_BUY_SCORE_THRESHOLD=60
TRADE_QUALITY_BUY_THRESHOLD=65
TRADE_QUALITY_CAN_PROPOSE_BUY=true
STRATEGY_VERSION=tq65_shadow60_risk_v1
SMART_MONEY_ENABLED=true
SMART_MONEY_SCORE_ENABLED=true
SMART_MONEY_MAX_SCORE=15
SMART_MONEY_SHADOW_ONLY=true
SMART_MONEY_TIMEFRAMES=15m,1h,4h
SMART_MONEY_SWING_LENGTH=5
SMART_MONEY_MIN_SCORE_FOR_BUY_BONUS=60
SMART_MONEY_MAX_TQ_BONUS=0
SMART_MONEY_NO_REPAINT=true
TA_FORECAST_ENABLED=true
TA_FORECAST_SHADOW_ONLY=true
TA_FORECAST_MAX_TQ_BONUS=0
TA_FORECAST_TIMEFRAMES=15m,1h,4h
TA_FORECAST_MIN_CONFIDENCE_FOR_BONUS=70
TA_FORECAST_NO_REPAINT=true
TA_SHADOW_MIN_SCORE=70
TA_SHADOW_MIN_CONFIDENCE=65
AI_TA_ENABLED=true
AI_TA_SHADOW_ONLY=true
AI_TA_MAX_TQ_BONUS=0
AI_TA_MODEL=claude-haiku-4-5
AI_TA_CALL_MODE=selective
AI_TA_MIN_TQ_TO_CALL=55
AI_TA_MIN_SMART_MONEY_TO_CALL=60
AI_TA_TIMEFRAMES=15m,1h,4h
AI_TA_USE_CLOSED_CANDLES_ONLY=true
AI_TA_NO_REPAINT=true
AI_TA_MAX_RECENT_CANDLES=120
AI_TA_SHADOW_MIN_SCORE=70
AI_TA_SHADOW_MIN_CONFIDENCE=65
AI_TA_BACKTEST_CALLS_AI=false
AI_TA_BACKTEST_MAX_AI_CALLS=100
LEARNING_ONLY_SCAN_ENABLED=true
LEARNING_ONLY_SCAN_INTERVAL_MINUTES=60
LEARNING_ONLY_SCAN_EXECUTES_TRADES=false
LEARNING_ONLY_CALL_CLAUDE_MODE=selective
LEARNING_ONLY_MAX_PER_DAY=24
